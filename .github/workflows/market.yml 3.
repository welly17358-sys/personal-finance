name: Update TWSE market quotes
on:
  schedule:
    - cron: '45 8 * * 1-5' # UTC 08:45 = Taipei 16:45, weekdays; may be delayed
  workflow_dispatch:
permissions:
  contents: write
jobs:
  refresh:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python scripts/update_market.py
      - name: Commit updated quotes
        run: |
          git config user.name github-actions[bot]
          git config user.email 41898282+github-actions[bot]@users.noreply.github.com
          git add data/market.json
          git diff --cached --quiet || (git commit -m "Update market close data" && git push)
